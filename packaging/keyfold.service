[Unit]
Description=Keyfold vault
After=network.target

[Service]
# systemd allocates a dedicated user and manages ownership of the persistent state.
DynamicUser=yes
StateDirectory=keyfold
StateDirectoryMode=0700
Environment=KEYFOLD_ALLOWED_HOSTS=vault.example.internal
ExecStart=/usr/local/bin/keyfold-server -listen 127.0.0.1:8717 -data /var/lib/keyfold -web /usr/local/share/keyfold/web
Restart=on-failure
TimeoutStopSec=20s
UMask=0077

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
